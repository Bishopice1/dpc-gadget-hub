# --- Supabase (Settings -> API) ---
# Project URL, e.g. https://xxxx.supabase.co (safe for browsers, RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public API key (safe for browsers, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, never expose to the browser; used for order creation
SUPABASE_SERVICE_ROLE_KEY=
# Canonical site URL used for auth redirects/metadata, e.g. https://dpc-gadget-hub.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mailgun (transactional emails, server-side only) ---
# Mailgun private API key (key-...)
MAILGUN_API_KEY=
# Mailgun sending domain, e.g. mg.yourdomain.com
MAILGUN_DOMAIN=
# From header for outgoing mail, e.g. DPC Gadget Hub <orders@mg.yourdomain.com>
MAILGUN_FROM=
# Inbox that receives new-order notification emails (shop owner)
SHOP_OWNER_EMAIL=

# --- Access control ---
# Comma-separated list of Google account emails allowed into /admin, e.g. you@gmail.com,staff@gmail.com
ADMIN_EMAILS=

# --- Store front ---
# WhatsApp number in international format without +, e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678